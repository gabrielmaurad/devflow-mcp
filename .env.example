# Copy this file to ".env" (same folder as server.py) and fill it in.
# ".env" is git-ignored. NEVER commit it, and never paste a token into a chat, screenshot or issue.

# GitHub personal access token. Optional, but required for PRIVATE repositories and it raises
# GitHub's hourly quota from 60 (anonymous) to 5,000.
# Recommended: a FINE-GRAINED token that is read-only:
#   GitHub > Settings > Developer settings > Personal access tokens > Fine-grained tokens > Generate new token
#   Repository access: "Only select repositories" (choose the ones you want to analyze)
#   Repository permissions: Contents = Read-only  (Metadata = Read-only is added automatically)
GITHUB_TOKEN=

# Rate limit: at most RATE_LIMIT_CALLS tool calls per RATE_LIMIT_WINDOW_SECONDS (defaults: 10 per 60).
# For the live demo you can set RATE_LIMIT_CALLS=3 so the limit is easy to trigger.
RATE_LIMIT_CALLS=10
RATE_LIMIT_WINDOW_SECONDS=60
